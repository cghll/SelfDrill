# SelfDrill 环境配置示例
# 复制为 backend/.env 后按需修改；.env 不纳入版本控制。

# --- 运行环境：development / production ---
APP_ENV=development

# --- 会话签名密钥 ---
# 生产环境必填，缺失会直接启动失败；开发环境留空会生成临时密钥（重启后会话失效）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# --- 数据库与文件 ---
# 相对路径基于 backend/ 目录解析
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# --- 上传限制（FR-003）---
MAX_UPLOAD_SIZE=10485760
MAX_UPLOAD_LINES=200000
MAX_PARSE_SECONDS=20

# --- 会话 ---
SESSION_COOKIE_NAME=selfdrill_session
# 生产环境使用 HTTPS 时必须为 true
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=2592000

# --- 导入预览有效期（秒）---
PREVIEW_TTL_SECONDS=21600

# --- 初始账号（FR-001：不开放注册，仅在库中无用户时创建）---
INITIAL_USERNAME=owner
INITIAL_PASSWORD=

# --- 开发环境前端跨域来源 ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
