# SelfDrill 部署环境变量示例
# 复制为 deploy/.env 后填写，deploy/.env 不会被提交。

# --- 必填 ---
# 会话签名密钥，生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# 首次启动时创建的唯一账号密码（库中已有用户时不会覆盖）
INITIAL_USERNAME=owner
INITIAL_PASSWORD=

# --- 站点 ---
# 有域名时填域名（Caddy 会自动申请 HTTPS 证书），内网访问保持 :80
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- 会话安全 ---
# 使用 HTTPS 时必须设为 true
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=2592000

# --- 上传与预览 ---
MAX_UPLOAD_SIZE=10485760
PREVIEW_TTL_SECONDS=21600

# --- 备份 ---
BACKUP_KEEP=7
BACKUP_INTERVAL_SECONDS=86400